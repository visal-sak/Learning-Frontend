# ── Frontend (exposed to the browser, must start with VITE_) ──────────────
# Token/API calls stay relative so they go through the Vite proxy (avoids Keycloak "Invalid origin")
VITE_API_BASE_URL=/api/v1
VITE_KEYCLOAK_URL=
# Where the browser is sent for the Keycloak login page (PKCE flow)
VITE_KEYCLOAK_BROWSER_URL=http://localhost:1401
VITE_KEYCLOAK_REALM=elearning
VITE_KEYCLOAK_CLIENT_ID=postman-app
# Must be one of the client's "Valid redirect URIs".
#   https://www.keycloak.org/app/      -> works with postman-app as-is; you paste the redirected URL back (like Postman)
#   (empty) = http://localhost:5173/auth/callback -> automatic, after adding http://localhost:5173/* to the client
VITE_KEYCLOAK_REDIRECT_URI=
# pkce     = redirect to Keycloak login (Standard flow + PKCE, recommended)
# password = custom username/password form (client needs "Direct access grants" ON)
VITE_AUTH_FLOW=pkce

# ── Dev proxy targets (read by vite.config.js only, never sent to the browser) ─
API_PROXY_TARGET=http://localhost:1444
KEYCLOAK_PROXY_TARGET=http://localhost:1401
